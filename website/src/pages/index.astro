---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedDocs } from "../lib/docs.js";
import "../styles/home.css";

const featured = getFeaturedDocs();

const runtimePackages = [
  {
    name: "@causal-order/transport",
    id: "runtime-transport",
    version: "0.2.0",
    role: "Ingress",
    summary: "Normalizes WebSocket and JSON node traffic into the shared event contract.",
    npm: "https://www.npmjs.com/package/@causal-order/transport",
  },
  {
    name: "@causal-order/monitor",
    id: "runtime-monitor",
    version: "0.6.0",
    role: "Optional resilience",
    summary: "Adds health-aware buffering, replay, and operator monitoring where delivery is fragile.",
    npm: "https://www.npmjs.com/package/@causal-order/monitor",
    optional: true,
  },
  {
    name: "@causal-order/dedupe",
    id: "runtime-dedupe",
    version: "1.2.0",
    role: "Identity",
    summary: "Filters duplicate event identities before they reach the ordering boundary.",
    npm: "https://www.npmjs.com/package/@causal-order/dedupe",
  },
  {
    name: "causal-order",
    id: "runtime-core",
    version: "1.0.1",
    role: "Ordering",
    summary: "Orders accepted events without turning partial evidence into false certainty.",
    npm: "https://www.npmjs.com/package/causal-order",
  },
];

const ecosystemStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "causal-order ecosystem packages",
  itemListElement: [
    ...runtimePackages.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${item.name} v${item.version}`,
      url: item.npm,
    })),
    {
      "@type": "ListItem",
      position: 5,
      name: "@causal-order/testing v0.3.1",
      url: "https://www.npmjs.com/package/@causal-order/testing",
    },
  ],
});
---

<BaseLayout
  title="causal-order | Distributed event integrity ecosystem"
  description="A five-package ecosystem for transport, recovery, duplicate filtering, causal ordering, and systems-level validation in distributed event flows."
>
  <script type="application/ld+json" set:html={ecosystemStructuredData}></script>

  <section class="hero">
    <div class="hero-copy">
      <div class="hero-badge">Five packages · one explicit contract</div>
      <h1>Distributed event delivery without false certainty.</h1>
      <p class="hero-lede">
        The <code>causal-order</code> ecosystem separates transport, recovery, identity,
        ordering, and qualification so each responsibility stays visible and replaceable.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#ecosystem">Explore the ecosystem</a>
        <a class="button button-secondary" href="/guides/quick-start-scenarios/">Start with core</a>
      </div>

      <div class="platform-line" aria-label="Published platform status">
        <span><strong>Published stack</strong></span>
        <span>Node.js ≥22.13.0</span>
        <span>Validated on Node.js 22 and 24</span>
      </div>
    </div>

    <aside class="stack-status" aria-label="Published ecosystem versions">
      <span class="card-kicker">Published package versions</span>
      <ol>
        {runtimePackages.map((item) => (
          <li>
            <a href="#ecosystem">
              <span>{item.name}</span>
              <strong>v{item.version}</strong>
            </a>
          </li>
        ))}
        <li class="testing-status">
          <a href="#ecosystem">
            <span>@causal-order/testing</span>
            <strong>v0.3.1</strong>
          </a>
        </li>
      </ol>
    </aside>
  </section>

  <section class="ecosystem-section" id="ecosystem">
    <div class="section-heading">
      <div>
        <span class="card-kicker">Runtime path</span>
        <h2>One owner for each operational responsibility.</h2>
      </div>
      <p>
        Compose only the layers the deployment needs. The event contract is the seam between
        packages; no package quietly absorbs another package’s job.
      </p>
    </div>

    <div class="runtime-flow">
      {runtimePackages.map((item, index) => (
        <>
          <article id={item.id} class:list={["package-card", item.optional && "package-card-optional"]}>
            <div class="package-card-topline">
              <span>{item.role}</span>
              {item.optional && <span class="optional-tag">optional</span>}
            </div>
            <h3><a class="package-card-link" href={item.npm} target="_blank" rel="noreferrer">{item.name}</a></h3>
            <span class="package-version">v{item.version}</span>
            <p>{item.summary}</p>
          </article>
          {index < runtimePackages.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>

    <article class="testing-layer" id="runtime-testing">
      <div>
        <span class="card-kicker">Qualification layer</span>
        <h3>
          <a class="testing-layer-link" href="https://www.npmjs.com/package/@causal-order/testing" target="_blank" rel="noreferrer">
            @causal-order/testing <span>v0.3.1</span>
          </a>
        </h3>
      </div>
      <p>
        Runs workloads, injects faults, captures artifacts, and returns verdicts across the
        installed system. Testing surrounds the stack; it is not another delivery stage.
      </p>
    </article>
  </section>

  <section class="install-section">
    <div class="section-heading section-heading-compact">
      <div>
        <span class="card-kicker">Compose the stack</span>
        <h2>Install the path your system actually runs.</h2>
      </div>
      <p>Monitor is optional. Testing belongs in qualification, not the production delivery path.</p>
    </div>

    <div class="install-grid">
      <article class="install-card">
        <span>Monitor-aware path</span>
        <div class="install-command-row">
          <code>npm install @causal-order/transport @causal-order/monitor @causal-order/dedupe causal-order</code>
          <button type="button" class="copy-command" data-copy-command>Copy</button>
        </div>
      </article>
      <article class="install-card">
        <span>Direct path</span>
        <div class="install-command-row">
          <code>npm install @causal-order/transport @causal-order/dedupe causal-order</code>
          <button type="button" class="copy-command" data-copy-command>Copy</button>
        </div>
      </article>
      <article class="install-card install-card-testing">
        <span>System qualification</span>
        <div class="install-command-row">
          <code>npm install --save-dev @causal-order/testing</code>
          <button type="button" class="copy-command" data-copy-command>Copy</button>
        </div>
      </article>
    </div>
  </section>

  <section class="ownership-grid">
    <article class="ownership-card">
      <span class="card-kicker">Narrow by design</span>
      <h2>Packages remain independently useful.</h2>
      <p>
        Adopt a single layer or the full runtime path. The ecosystem does not require one large
        framework or hide transport and recovery policy inside ordering.
      </p>
    </article>
    <article class="ownership-card">
      <span class="card-kicker">Evidence over appearance</span>
      <h2>Ordering claims remain bounded.</h2>
      <p>
        Replay, reconnects, late arrivals, and partial clocks are surfaced as operational facts—not
        polished into a timeline that looks more certain than the evidence allows.
      </p>
    </article>
    <article class="ownership-card">
      <span class="card-kicker">System qualification</span>
      <h2>The composed path gets tested.</h2>
      <p>
        Faults and workloads exercise package boundaries together, producing artifacts and verdicts
        that can be reviewed before the stack is trusted in production.
      </p>
    </article>
  </section>

  <section class="core-docs-section">
    <div class="core-docs-copy">
      <span class="card-kicker">Core documentation</span>
      <h2>This site is also the reference for <code>causal-order</code> v1.0.1.</h2>
      <p>
        Use the guides for deployment decisions, the wiki for the reasoning model, and the API
        reference for the core ordering runtime’s exported surface.
      </p>
      <a class="button button-secondary" href="/api/">Open the core API</a>
    </div>

    <div class="home-grid">
      <article class="home-card">
        <span class="card-kicker">Deployment layer</span>
        <h3><a href="/guides/">Guides</a></h3>
        <ul class="home-links">
          {featured.guides.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </article>

      <article class="home-card">
        <span class="card-kicker">Conceptual layer</span>
        <h3><a href="/wiki/">Wiki</a></h3>
        <ul class="home-links">
          {featured.wiki.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <script>
    const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-command]");

    for (const button of copyButtons) {
      button.addEventListener("click", async () => {
        const command = button.parentElement?.querySelector("code")?.textContent?.trim();

        if (!command) return;

        try {
          await navigator.clipboard.writeText(command);
          button.textContent = "Copied";
          button.classList.add("is-copied");
          window.setTimeout(() => {
            button.textContent = "Copy";
            button.classList.remove("is-copied");
          }, 1600);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        }
      });
    }
  </script>
</BaseLayout>
